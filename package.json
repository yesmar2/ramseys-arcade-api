{
  "name": "ramseys-arcade-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/writeSeed.ts",
    "seed:world": "tsx src/seedWorld.ts",
    "avatars:refresh": "tsx src/refreshAvatars.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "dev:neon": "neon-env run --branch dev -- tsx watch src/index.ts",
    "push:test": "tsx --env-file=.env src/devPush.ts",
    "smoke:anticheat": "node scripts/smoke-anticheat.mjs",
    "audit:runs": "node scripts/inspect-run-audit.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.3.3",
    "@neon/env": "^1.2.4",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "google-auth-library": "^11.0.2",
    "postgres": "^3.4.9",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
