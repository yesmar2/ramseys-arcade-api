# Google OAuth (Sign in with Google)
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Authorized JavaScript origins: http://localhost:5173 (and your prod origin)
GOOGLE_CLIENT_ID=

# Frontend origin used when building magic-link URLs
FRONTEND_ORIGIN=http://localhost:5173

# Neon Postgres pooled connection string (required)
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Which Neon branch DATABASE_URL points at. This is not decoration: the
# destructive paths below refuse to run unless this names a non-production
# branch, and an unset value is treated as production. Local development should
# name a dev branch and use that branch's DATABASE_URL.
NEON_BRANCH=dev

PORT=8787
HOST=0.0.0.0

# Optional: fill empty boards with sample scores on boot
# SEED_SAMPLE=1
# Optional: wipe boards/records/trophies once on next boot.
# Also fires on a SEED_REVISION bump, so editing that constant empties the
# boards on the next boot too. Refused unless NEON_BRANCH names a dev branch.
# SEED_FORCE=1

# Last resort: run the destructive paths against production on purpose.
# ALLOW_PRODUCTION_WRITES=1

# Print one line per request with its wall time and database round trips.
LOG_REQUESTS=0

# Refuse any score that did not come from a run opened through POST /runs/start.
# Leave this off until every released client sends a runId — a browser holding
# an older build would otherwise be unable to save anything. Turn it on once the
# site has been deployed and `node scripts/inspect-run-audit.mjs` shows new
# scores carrying run ids.
# REQUIRE_RUN_TOKEN=1

# Salt for the address hash stored beside each score. Any long random string;
# set it in production so the hashes are not guessable, and rotate it to make
# old hashes stop correlating. Scores keep saving without it.
# IP_HASH_SALT=

# Web push. Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Push is optional — without these the app runs and the inbox still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
